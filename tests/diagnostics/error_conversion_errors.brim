enum AppError {
    Message(string)
    Other(string)
    Code(i64)
}

fn text() -> Result[i64, string] {
    return Err("x")
}

fn flag() -> Result[i64, bool] {
    return Err(true)
}

fn ambiguous() -> Result[i64, AppError] {
    let n: i64 = text()?
    return Ok(n)
}

fn no_variant() -> Result[i64, AppError] {
    let n: i64 = flag()?
    return Ok(n)
}

fn not_an_enum() -> Result[i64, i64] {
    let n: i64 = text()?
    return Ok(n)
}

fn main() {
    ambiguous()
    no_variant()
    not_an_enum()
}
