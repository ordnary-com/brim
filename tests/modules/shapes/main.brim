// A program of several modules: `import geometry` makes `geometry.x`
// available; `import text.format.{pad}` brings `pad` in by name.

import geometry
import text.format.{pad, Report}

fn main() {
    let shapes: List[geometry.Shape] = [
        geometry.Shape.Circle(2),
        geometry.square(3),
        geometry.Shape.Rect(geometry.Size { width: 2, height: 5 }),
    ]
    let mut report: Report = Report.new("shapes")
    for shape in shapes {
        report.add(pad(geometry.describe(shape), 12) + to_string(geometry.area(shape)))
    }
    print(report.render())
    print(geometry.total_area(shapes))
}
