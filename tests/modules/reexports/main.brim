// `pub import` re-exports items of another module, and fields without
// `pub` stay inside their module.

import api
import api.{Item, MAX_ITEMS}

fn main() {
    let items: List[Item] = [api.item("tea", 3), api.item("cake", 4)]
    print(api.total(items))
    print(items[0].name)
    print(api.cents(items[1]))
    print(MAX_ITEMS)
    print(api.MAX_ITEMS == MAX_ITEMS)
}
