// std.process: running programs through `sh`.
import std.process

fn show(result: Result[process.Output, string]) {
    match result {
        Ok(out) => {
            print(f"code {out.code}, success {out.success()}")
            print(f"stdout: {out.stdout.trim()}")
            print(f"stderr: {out.stderr.trim()}")
        }
        Err(e) => print("error: " + e),
    }
}

fn main() {
    show(process.run("sh", ["-c", "echo hello; echo careful >&2"]))
    show(process.run("sh", ["-c", "exit 7"]))
    show(process.run("brim-no-such-program", ["x"]))
    show(process.run("sh", ["-c", "printf '\\377'"]))

    // Arguments are passed as they are, without a shell in between.
    show(process.run("sh", ["-c", "printf '%s|' \"$@\"", "sh", "two words", "", "$HOME"]))

    // Large output on both streams at once does not block.
    match process.run("sh", ["-c", "i=0; while [ $i -lt 20000 ]; do echo out; echo err >&2; i=$((i+1)); done"]) {
        Ok(out) => print(f"{out.stdout.len()} {out.stderr.len()}"),
        Err(e) => print("error: " + e),
    }

    // The program gets no input.
    show(process.run("sh", ["-c", "cat"]))

    print(process.output("sh", ["-c", "echo fine"]).unwrap_or("?").trim())
    match process.output("sh", ["-c", "echo broken >&2; exit 3"]) {
        Ok(_) => print("?"),
        Err(e) => print(e),
    }
    match process.output("sh", ["-c", "exit 4"]) {
        Ok(_) => print("?"),
        Err(e) => print(e),
    }
}
