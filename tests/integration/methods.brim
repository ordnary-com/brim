// Methods: `self` is a copy of the value; `mut self` changes the caller's
// variable; methods without `self` are called on the type.

struct Point {
    x: i64
    y: i64
}

impl Point {
    fn origin() -> Point {
        return Point { x: 0, y: 0 }
    }

    fn manhattan(self) -> i64 {
        return abs(self.x) + abs(self.y)
    }

    fn shifted(self, dx: i64, dy: i64) -> Point {
        return Point { x: self.x + dx, y: self.y + dy }
    }

    fn shift(mut self, dx: i64, dy: i64) {
        self.x += dx
        self.y += dy
    }

    fn describe(self) -> string {
        return "(" + to_string(self.x) + ", " + to_string(self.y) + ")"
    }
}

fn abs(n: i64) -> i64 {
    if n < 0 {
        return -n
    }
    return n
}

struct Stack[T] {
    items: List[T]
}

impl Stack[T] {
    fn new() -> Stack[T] {
        return Stack { items: [] }
    }

    fn push(mut self, item: T) {
        self.items.push(item)
    }

    fn pop(mut self) -> Option[T] {
        return self.items.pop()
    }

    fn size(self) -> i64 {
        return self.items.len()
    }
}

enum Shape {
    Circle(i64)
    Square(i64)
}

impl Shape {
    fn area(self) -> i64 {
        match self {
            Circle(r) => return 3 * r * r
            Square(s) => return s * s
        }
    }
}

struct Game {
    players: List[Point]
}

fn main() {
    let mut p: Point = Point.origin()
    p.shift(3, -4)
    print(p.describe())
    print(p.manhattan())
    print(p.shifted(1, 1).describe())
    print(p.describe())

    let mut stack: Stack[string] = Stack.new()
    stack.push("a")
    stack.push("b")
    stack.push("c")
    print(stack.size())
    match stack.pop() {
        Some(top) => print(top)
        None => print("empty")
    }
    print(stack.size())

    print(Shape.Circle(2).area() + Shape.Square(3).area())

    // `mut self` methods on parts of a variable.
    let mut game: Game = Game { players: [Point.origin(), Point.origin()] }
    game.players[1].shift(5, 5)
    print(game.players[1].describe())

    // A big stack: `mut self` changes the list in place.
    let mut numbers: Stack[i64] = Stack.new()
    for i in 0..100000 {
        numbers.push(i)
    }
    print(numbers.size())
}
