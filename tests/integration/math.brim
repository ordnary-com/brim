// abs, sqrt, pow, floor, ceil, round, min, max, clamp, PI and E.

fn main() {
    print(abs(-7))
    print(abs(-2.5))
    print(sqrt(16.0))
    print(sqrt(2.0))
    print(sqrt(-1.0))
    print(pow(2, 10))
    print(pow(-3, 3))
    print(pow(2, -1))
    print(pow(-1, -3))
    print(pow(2.0, 0.5))
    print(pow(10.0, -2.0))
    print(floor(2.7))
    print(floor(-2.2))
    print(ceil(2.2))
    print(round(2.5))
    print(round(-2.5))
    print(round(2.4999))
    print(min(3, 8))
    print(max(3, 8))
    print(min("pear", "apple"))
    print(max(1.5, -1.5))
    let small: u8 = 200
    print(min(small, 100))
    print(clamp(150, 0, 100))
    print(clamp(-5, 0, 100))
    print(clamp(0.5, 0.0, 1.0))
    print(PI)
    print(E)
    let r = 2.0
    print(round(PI * r * r * 100.0) / 100.0)
    print(to_int(floor(sqrt(to_float(50)))))
}
