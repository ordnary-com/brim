// An HTTP server within one program: a raw client writes requests, the
// server parses and answers them, and the client reads the responses.
use @std/http
use @std/net

// `raw` with `Connection: close` after the request line, so the client
// can read the response to the end.
fn closing(raw: string) -> string {
    let end = raw.find("\r\n").unwrap_or(raw.len())
    return raw.slice(0, end) + "\r\nConnection: close" + raw.slice(end, raw.len())
}

fn exchange(server: http.Server, raw: string) -> Result[string, string] {
    let client: net.Conn = net.connect("127.0.0.1", server.port())?
    client.write(closing(raw))?
    let request: http.Request = server.next()?
    let mut seen: string = request.method + " " + request.path
    for name in request.query.keys() {
        seen = seen + " " + name + "=" + request.query[name]
    }
    match request.header("Content-Type") {
        Some(t) => seen = seen + " type=" + t
        None => {}
    }
    if !request.body.is_empty() {
        seen = seen + " body=" + request.body
    }
    print("server: " + seen)
    let mut response: http.Response = http.not_found()
    if request.path == "/hi" {
        response = http.text(200, "hello").with_header("X-Answer", "42")
    }
    request.respond(response)?
    let reply: string = client.read_all()?
    client.close()
    return Ok(reply.replace("\r\n", " | "))
}

// Sends a request the server refuses, then shows the client's response.
fn refused(server: http.Server, raw: string) -> Result[i64, string] {
    let client: net.Conn = net.connect("127.0.0.1", server.port())?
    client.write(raw)?
    // The server reads the next request after refusing this one; this
    // client answers that with a request of its own.
    let next: net.Conn = net.connect("127.0.0.1", server.port())?
    next.write("GET /next HTTP/1.1\r\n\r\n")?
    let request: http.Request = server.next()?
    request.respond(http.text(200, "next"))?
    next.close()
    let reply: string = client.read_all()?
    print("refused: " + reply.split("\r\n")[0] + " / " + reply.split("\r\n\r\n")[1].trim())
    client.close()
    return Ok(0)
}

// Keep-alive: two requests sent at once on one connection, a second
// client while that connection is kept, then a request that asks to close.
fn keep_alive(server: http.Server) -> Result[i64, string] {
    let client = net.connect("127.0.0.1", server.port())?
    client.write("GET /one HTTP/1.1\r\n\r\nGET /two HTTP/1.1\r\n\r\n")?
    let first = server.next()?
    first.respond(http.text(200, "one"))?
    let second = server.next()?
    second.respond(http.text(200, "two"))?
    let other = net.connect("127.0.0.1", server.port())?
    other.write("GET /other HTTP/1.0\r\n\r\n")?
    let third = server.next()?
    third.respond(http.text(200, "other"))?
    print("other: " + other.read_all()?.replace("\r\n", " | "))
    other.close()
    client.write("GET /three HTTP/1.1\r\nConnection: close\r\n\r\n")?
    let last = server.next()?
    last.respond(http.text(200, "three"))?
    print("kept: " + first.path + " " + second.path + " " + third.path + " " + last.path)
    print("kept: " + client.read_all()?.replace("\r\n", " | "))
    client.close()
    // A kept connection the client closes is dropped quietly.
    let quiet = net.connect("127.0.0.1", server.port())?
    quiet.write("GET /quiet HTTP/1.1\r\n\r\n")?
    let request = server.next()?
    request.respond(http.text(200, "quiet"))?
    quiet.close()
    print(exchange(server, "GET /after-quiet HTTP/1.1\r\n\r\n")?)
    return Ok(0)
}

fn run() -> Result[i64, string] {
    let server: http.Server = http.serve("127.0.0.1", 0)?
    print(exchange(server, "GET /hi?name=Ada+L&x=%C3%A9 HTTP/1.1\r\nHost: x\r\n\r\n")?)
    print(exchange(server, "POST /form HTTP/1.1\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello")?)
    print(exchange(server, "POST /chunks HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n7\r\n, world\r\n0\r\n\r\n")?)
    print(exchange(server, "HEAD /hi HTTP/1.1\r\n\r\n")?)
    keep_alive(server)?
    // Not HTTP: the client gets 400 and the server waits for the next.
    let bad: net.Conn = net.connect("127.0.0.1", server.port())?
    bad.write("nonsense\r\n\r\n")?
    print(exchange(server, "GET /after-bad HTTP/1.1\r\n\r\n")?)
    print("bad client: " + bad.read_all()?.replace("\r\n", " | "))
    // Limits: a small body limit, then bodies and headers that are too big.
    let small: http.Server = server.with_max_body(10)
    print(exchange(small, "POST /ok HTTP/1.1\r\nContent-Length: 10\r\n\r\n0123456789")?)
    refused(small, "POST /big HTTP/1.1\r\nContent-Length: 11\r\n\r\n01234567890")?
    refused(small, "POST /big HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n6\r\n012345\r\n6\r\n678901\r\n0\r\n\r\n")?
    refused(small, "GET / HTTP/1.1\r\nX-Big: " + "x".repeat(70000) + "\r\n\r\n")?
    print(exchange(small, "GET /hi HTTP/1.1\r\n\r\n")?)
    server.close()
    print(http.encode("a b/é"))
    print(http.decode("a+b%2F%C3%A9")?)
    match http.decode("%zz") {
        Ok(_) => print("unexpected")
        Err(e) => print(e)
    }
    return Ok(0)
}

fn main() {
    match run() {
        Ok(_) => print("done")
        Err(e) => print("error: " + e)
    }
}
