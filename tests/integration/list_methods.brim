// Sorting, reversing, slicing and searching lists.

struct Person {
    name: string
    age: i64
}

fn main() {
    let numbers = [5, 3, 9, 1, 3, 7]
    print(numbers.sorted())
    print(numbers.reversed())
    print(numbers.slice(1, 4))
    print(numbers.slice(-5, 100))
    print(numbers.slice(4, 2))
    print(numbers.index_of(3))
    print(numbers.index_of(42))
    print(numbers)

    print(["pear", "apple", "fig"].sorted())
    print([2.5, -1.0, 0.5].sorted())
    let none: List[i64] = []
    print(none.sorted())
    print(none.reversed())

    let people = [
        Person { name: "ada", age: 36 },
        Person { name: "alan", age: 41 },
        Person { name: "grace", age: 36 },
    ]
    // Stable: equal ages keep their order.
    let by_age = people.sorted_by(fn(a: Person, b: Person) -> bool {
        return a.age < b.age
    })
    for p in by_age {
        print(f"{p.name} {p.age}")
    }
    let oldest_first = people.sorted_by(fn(a: Person, b: Person) -> bool {
        return a.age > b.age
    })
    print(oldest_first[0].name)
    print(people.index_of(Person { name: "alan", age: 41 }))

    let mut big: List[i64] = []
    for i in 0..1000 {
        big.push((i * 7919) % 1000)
    }
    let sorted = big.sorted()
    print(f"{sorted[0]} {sorted[500]} {sorted[999]}")
}
