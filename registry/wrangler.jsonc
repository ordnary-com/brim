{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brim-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "registry.brimlang.com", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVES",
      "bucket_name": "brim-registry-archives"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brim-registry",
      "database_id": "ecc94d0f-2cb1-42a6-9846-972e2ada3ec8",
      "migrations_dir": "migrations"
    }
  ],
  // ADMIN_TOKEN is set with `wrangler secret put ADMIN_TOKEN` (and in .dev.vars locally).
  "secrets": {
    "required": ["ADMIN_TOKEN"]
  }
}
