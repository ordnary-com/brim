## Brim syntax for nano. Add `include "/path/to/brim.nanorc"` to ~/.nanorc.
syntax brim "\.brim$"
comment "//"

color brightblue "\<(fn|let|mut|return|if|else|while|for|in|match|break|continue|struct|enum|impl|pub|import|as)\>"
color red "\<(async|await|const|loop|trait|type|use)\>"
color green "\<(i64|i32|u8|u64|f64|bool|string|void|Option|Result|List|Map|Set|Box)\>"
color green "\<[A-Z][A-Za-z0-9_]*\>"
color magenta "\<(true|false|self|Some|None|Ok|Err)\>"
color cyan "\<(print|eprint|to_string|to_float|to_int|to_i32|to_u8|to_u64|string_from_bytes|from_code_point|abs|sqrt|floor|ceil|round|pow|min|max|clamp|read_line|read_file|write_file|args|env|exit|assert|assert_eq)\>"
color yellow "\<[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\>"
color yellow ""([^"\\]|\\.)*""
color brightyellow "\\([nrt0"\\]|u\{[0-9a-fA-F]+\})"
color brightblack "//.*"
