// The prelude: functions and constants every program has, written in
// Brim itself. `min(a, b)` and `PI` are used by name; the functions named
// `list_...` are the methods of lists: `xs.sorted()` is `list_sorted(xs)`.

// ---- numbers -------------------------------------------------------------

// The ratio of a circle's circumference to its diameter.
pub const PI: f64 = 3.141592653589793

// The base of the natural logarithm.
pub const E: f64 = 2.718281828459045

// The smaller of two values (`a` when they are equal).
pub fn min[T: Ord](a: T, b: T) -> T {
    return if b < a { b } else { a }
}

// The larger of two values (`a` when they are equal).
pub fn max[T: Ord](a: T, b: T) -> T {
    return if b > a { b } else { a }
}

// `x`, moved into the range from `low` to `high`.
pub fn clamp[T: Ord](x: T, low: T, high: T) -> T {
    return min(max(x, low), high)
}

// ---- Option and Result ---------------------------------------------------

// Whether there is a value.
pub fn option_is_some[T](o: Option[T]) -> bool {
    return match o {
        Some(_) => true
        None => false
    }
}

// Whether there is no value.
pub fn option_is_none[T](o: Option[T]) -> bool {
    return !option_is_some(o)
}

// The value, or `fallback` when there is none.
pub fn option_unwrap_or[T](o: Option[T], fallback: T) -> T {
    return match o {
        Some(x) => x
        None => fallback
    }
}

// `Some(f(x))` for `Some(x)`; `None` stays `None`.
pub fn option_map[T, U](o: Option[T], f: fn(T) -> U) -> Option[U] {
    return match o {
        Some(x) => Some(f(x))
        None => None
    }
}

// Whether it is `Ok`.
pub fn result_is_ok[T, E](r: Result[T, E]) -> bool {
    return match r {
        Ok(_) => true
        Err(_) => false
    }
}

// Whether it is `Err`.
pub fn result_is_err[T, E](r: Result[T, E]) -> bool {
    return !result_is_ok(r)
}

// The `Ok` value, or `fallback` for an `Err`.
pub fn result_unwrap_or[T, E](r: Result[T, E], fallback: T) -> T {
    return match r {
        Ok(x) => x
        Err(_) => fallback
    }
}

// The `Ok` value as an `Option`; the error is dropped.
pub fn result_ok[T, E](r: Result[T, E]) -> Option[T] {
    return match r {
        Ok(x) => Some(x)
        Err(_) => None
    }
}

// `Ok(f(x))` for `Ok(x)`; an `Err` stays as it is.
pub fn result_map[T, E, U](r: Result[T, E], f: fn(T) -> U) -> Result[U, E] {
    return match r {
        Ok(x) => Ok(f(x))
        Err(e) => Err(e)
    }
}

// ---- strings -------------------------------------------------------------

// The number of characters (Unicode code points) in `s`; `len()` counts
// bytes.
pub fn string_char_count(s: string) -> i64 {
    return s.code_points().len()
}

// Builds a string from many pieces. Joining with `+` in a loop copies the
// text so far each time; a builder keeps the pieces and joins them once:
//
//     let mut out = StringBuilder.new()
//     for name in names {
//         out.add(name)
//         out.add(", ")
//     }
//     print(out.build())
pub struct StringBuilder {
    parts: List[string]
}

impl StringBuilder {
    // An empty builder.
    pub fn new() -> StringBuilder {
        return StringBuilder { parts: [] }
    }

    // Adds `text` at the end.
    pub fn add(mut self, text: string) {
        self.parts.push(text)
    }

    // Adds `text` and a line break.
    pub fn add_line(mut self, text: string) {
        self.parts.push(text)
        self.parts.push("\n")
    }

    // Whether nothing has been added (or only empty strings).
    pub fn is_empty(self) -> bool {
        for part in self.parts {
            if part.len() > 0 {
                return false
            }
        }
        return true
    }

    // The text added so far.
    pub fn build(self) -> string {
        return self.parts.join("")
    }
}

// ---- lists ---------------------------------------------------------------

// A sorted copy of `xs`, smallest first. The sort is stable: equal values
// keep their order.
pub fn list_sorted[T: Ord](xs: List[T]) -> List[T] {
    return list_sorted_by(xs, fn(a: T, b: T) -> bool {
        return a < b
    })
}

// A copy of `xs` sorted so that `less(a, b)` holds for each `a` before
// `b`, unless they are equal; stable, like `sorted`.
pub fn list_sorted_by[T](xs: List[T], less: fn(T, T) -> bool) -> List[T] {
    // Bottom-up merge sort: runs of 1, 2, 4, ... elements are merged.
    let n = xs.len()
    let mut from = xs
    let mut width = 1
    while width < n {
        let mut into: List[T] = []
        let mut start = 0
        while start < n {
            let middle = min(start + width, n)
            let end = min(start + 2 * width, n)
            let mut i = start
            let mut j = middle
            while i < middle || j < end {
                // Take from the right run only when it is strictly smaller,
                // so equal values keep their order.
                if j < end && (i == middle || less(from[j], from[i])) {
                    into.push(from[j])
                    j += 1
                } else {
                    into.push(from[i])
                    i += 1
                }
            }
            start = end
        }
        from = into
        width = width * 2
    }
    return from
}

// A copy of `xs` with the elements in the opposite order.
pub fn list_reversed[T](xs: List[T]) -> List[T] {
    let mut out: List[T] = []
    let mut i = xs.len() - 1
    while i >= 0 {
        out.push(xs[i])
        i -= 1
    }
    return out
}

// The elements from index `start` up to, but not including, `end`. Indices
// outside the list are moved to its start or end, so the result is never
// an error: `[1, 2, 3].slice(1, 10)` is `[2, 3]`.
pub fn list_slice[T](xs: List[T], start: i64, end: i64) -> List[T] {
    let from = max(start, 0)
    let to = min(end, xs.len())
    let mut out: List[T] = []
    let mut i = from
    while i < to {
        out.push(xs[i])
        i += 1
    }
    return out
}

// The index of the first element equal to `x`, or `None`.
pub fn list_index_of[T: Eq](xs: List[T], x: T) -> Option[i64] {
    let mut i = 0
    for y in xs {
        if y == x {
            return Some(i)
        }
        i += 1
    }
    return None
}

// `f(x)` for each element `x`, in a new list.
pub fn list_map[T, U](xs: List[T], f: fn(T) -> U) -> List[U] {
    let mut out: List[U] = []
    for x in xs {
        out.push(f(x))
    }
    return out
}

// The elements for which `keep` is true, in order.
pub fn list_filter[T](xs: List[T], keep: fn(T) -> bool) -> List[T] {
    let mut out: List[T] = []
    for x in xs {
        if keep(x) {
            out.push(x)
        }
    }
    return out
}

// Whether `test` is true for at least one element.
pub fn list_any[T](xs: List[T], test: fn(T) -> bool) -> bool {
    for x in xs {
        if test(x) {
            return true
        }
    }
    return false
}

// Whether `test` is true for every element (also for an empty list).
pub fn list_all[T](xs: List[T], test: fn(T) -> bool) -> bool {
    for x in xs {
        if !test(x) {
            return false
        }
    }
    return true
}

// `init` combined with each element in turn: `f(f(f(init, a), b), c)`.
pub fn list_fold[T, A](xs: List[T], init: A, f: fn(A, T) -> A) -> A {
    let mut acc = init
    for x in xs {
        acc = f(acc, x)
    }
    return acc
}

// The first element for which `test` is true, or `None`.
pub fn list_find[T](xs: List[T], test: fn(T) -> bool) -> Option[T] {
    for x in xs {
        if test(x) {
            return Some(x)
        }
    }
    return None
}

// Calls `f` with each element, in order.
pub fn list_each[T](xs: List[T], f: fn(T)) {
    for x in xs {
        f(x)
    }
}

// The smallest element, or `None` for an empty list.
pub fn list_min[T: Ord](xs: List[T]) -> Option[T] {
    let mut best = xs.first()?
    for x in xs {
        if x < best {
            best = x
        }
    }
    return Some(best)
}

// The largest element, or `None` for an empty list.
pub fn list_max[T: Ord](xs: List[T]) -> Option[T] {
    let mut best = xs.first()?
    for x in xs {
        if x > best {
            best = x
        }
    }
    return Some(best)
}

// The sum of the elements; 0 for an empty list. Overflow stops the program.
pub fn list_sum_i64(xs: List[i64]) -> i64 {
    let mut total: i64 = 0
    for x in xs {
        total = total + x
    }
    return total
}

// The sum of the elements; 0 for an empty list. Overflow stops the program.
pub fn list_sum_i32(xs: List[i32]) -> i32 {
    let mut total: i32 = 0
    for x in xs {
        total = total + x
    }
    return total
}

// The sum of the elements; 0 for an empty list. Overflow stops the program.
pub fn list_sum_u8(xs: List[u8]) -> u8 {
    let mut total: u8 = 0
    for x in xs {
        total = total + x
    }
    return total
}

// The sum of the elements; 0 for an empty list. Overflow stops the program.
pub fn list_sum_u64(xs: List[u64]) -> u64 {
    let mut total: u64 = 0
    for x in xs {
        total = total + x
    }
    return total
}

// The sum of the elements; 0 for an empty list.
pub fn list_sum_f64(xs: List[f64]) -> f64 {
    let mut total: f64 = 0.0
    for x in xs {
        total = total + x
    }
    return total
}

// ---- sets ----------------------------------------------------------------

// The distinct elements of `xs`, in the order they first appear: `Set(xs)`.
pub fn set_from_list[T: Key](xs: List[T]) -> Set[T] {
    let mut s: Set[T] = Set()
    for x in xs {
        s.add(x)
    }
    return s
}

// The elements in `a`, `b` or both.
pub fn set_union[T: Key](a: Set[T], b: Set[T]) -> Set[T] {
    let mut out = a
    for x in b {
        out.add(x)
    }
    return out
}

// The elements in both `a` and `b`.
pub fn set_intersection[T: Key](a: Set[T], b: Set[T]) -> Set[T] {
    let mut out: Set[T] = Set()
    for x in a {
        if b.contains(x) {
            out.add(x)
        }
    }
    return out
}

// The elements in `a` but not in `b`.
pub fn set_difference[T: Key](a: Set[T], b: Set[T]) -> Set[T] {
    let mut out: Set[T] = Set()
    for x in a {
        if !b.contains(x) {
            out.add(x)
        }
    }
    return out
}

// Whether every element of `a` is in `b`.
pub fn set_is_subset[T: Key](a: Set[T], b: Set[T]) -> bool {
    for x in a {
        if !b.contains(x) {
            return false
        }
    }
    return true
}
