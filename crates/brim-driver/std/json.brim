// JSON: reading JSON text into values, and writing values as JSON text.
//
//   import std.json
//
//   let value: json.Json = json.parse("{\"name\": \"Ada\", \"tags\": [\"x\"]}")?
//   match value.get("name") {
//       Some(name) => print(json.stringify(name))
//       None => print("no name")
//   }
//   let reply: json.Json = json.object(["ok": json.from_bool(true)])
//   print(json.stringify(reply))     // {"ok":true}
//
// Numbers are kept as they are written (`42`, `-1.5e3`), so none loses
// precision; `as_int` reads whole numbers and `as_float` any number.

// A JSON value.
pub enum Json {
    Null,
    Bool(bool),
    // A number, as written in the JSON text.
    Number(string),
    Str(string),
    Array(List[Json]),
    // Members keep the order of the text; a repeated key keeps its last
    // value.
    Object(Map[string, Json]),
}

// ---- building values ---------------------------------------------------

pub fn null() -> Json {
    return Json.Null
}

pub fn from_bool(value: bool) -> Json {
    return Json.Bool(value)
}

pub fn from_int(value: i64) -> Json {
    return Json.Number(to_string(value))
}

// A number; NaN and infinities, which JSON cannot hold, become `null`.
pub fn from_float(value: f64) -> Json {
    if value != value || value == 1.0 / 0.0 || value == -1.0 / 0.0 {
        return Json.Null
    }
    return Json.Number(to_string(value))
}

pub fn from_string(value: string) -> Json {
    return Json.Str(value)
}

pub fn array(items: List[Json]) -> Json {
    return Json.Array(items)
}

pub fn object(members: Map[string, Json]) -> Json {
    return Json.Object(members)
}

// ---- reading values ----------------------------------------------------

impl Json {
    // A member of an object.
    pub fn get(self, key: string) -> Option[Json] {
        match self {
            Json.Object(members) => return members.get(key)
            _ => return None
        }
    }

    // An element of an array.
    pub fn at(self, index: i64) -> Option[Json] {
        match self {
            Json.Array(items) => return items.get(index)
            _ => return None
        }
    }

    pub fn as_string(self) -> Option[string] {
        match self {
            Json.Str(text) => return Some(text)
            _ => return None
        }
    }

    // A whole number; `None` for other values and for numbers with a
    // fraction or exponent.
    pub fn as_int(self) -> Option[i64] {
        match self {
            Json.Number(text) => return text.parse_int()
            _ => return None
        }
    }

    // Any number, as the nearest `f64`.
    pub fn as_float(self) -> Option[f64] {
        match self {
            Json.Number(text) => return text.parse_float()
            _ => return None
        }
    }

    pub fn as_bool(self) -> Option[bool] {
        match self {
            Json.Bool(value) => return Some(value)
            _ => return None
        }
    }

    pub fn as_array(self) -> Option[List[Json]] {
        match self {
            Json.Array(items) => return Some(items)
            _ => return None
        }
    }

    pub fn as_object(self) -> Option[Map[string, Json]] {
        match self {
            Json.Object(members) => return Some(members)
            _ => return None
        }
    }

    pub fn is_null(self) -> bool {
        match self {
            Json.Null => return true
            _ => return false
        }
    }

    // "null", "bool", "number", "string", "array" or "object".
    pub fn kind(self) -> string {
        match self {
            Json.Null => return "null"
            Json.Bool(_) => return "bool"
            Json.Number(_) => return "number"
            Json.Str(_) => return "string"
            Json.Array(_) => return "array"
            Json.Object(_) => return "object"
        }
    }
}

// ---- writing -----------------------------------------------------------

// The value as compact JSON text.
pub fn stringify(value: Json) -> string {
    match value {
        Json.Null => return "null"
        Json.Bool(b) => return to_string(b)
        Json.Number(text) => return text
        Json.Str(text) => return quote(text)
        Json.Array(items) => {
            let mut parts: List[string] = []
            for item in items {
                parts.push(stringify(item))
            }
            return "[" + parts.join(",") + "]"
        }
        Json.Object(members) => {
            let mut parts: List[string] = []
            for key in members.keys() {
                parts.push(quote(key) + ":" + stringify(members[key]))
            }
            return "{" + parts.join(",") + "}"
        }
    }
}

// The value as JSON text indented by two spaces per level.
pub fn pretty(value: Json) -> string {
    return indented(value, "")
}

fn indented(value: Json, indent: string) -> string {
    let inner: string = indent + "  "
    match value {
        Json.Array(items) => {
            if items.is_empty() {
                return "[]"
            }
            let mut parts: List[string] = []
            for item in items {
                parts.push(inner + indented(item, inner))
            }
            return "[\n" + parts.join(",\n") + "\n" + indent + "]"
        }
        Json.Object(members) => {
            if members.is_empty() {
                return "{}"
            }
            let mut parts: List[string] = []
            for key in members.keys() {
                parts.push(inner + quote(key) + ": " + indented(members[key], inner))
            }
            return "{\n" + parts.join(",\n") + "\n" + indent + "}"
        }
        _ => return stringify(value)
    }
}

// A JSON string literal.
pub fn quote(text: string) -> string {
    let mut parts: List[string] = ["\""]
    for c in text.chars() {
        if c == "\"" {
            parts.push("\\\"")
        } else if c == "\\" {
            parts.push("\\\\")
        } else if c == "\n" {
            parts.push("\\n")
        } else if c == "\r" {
            parts.push("\\r")
        } else if c == "\t" {
            parts.push("\\t")
        } else {
            let code: i64 = __char_code(c)
            if code < 32 {
                parts.push("\\u00" + hex_digit(code / 16) + hex_digit(code % 16))
            } else {
                parts.push(c)
            }
        }
    }
    parts.push("\"")
    return parts.join("")
}

fn hex_digit(n: i64) -> string {
    return "0123456789abcdef".slice(n, n + 1)
}

// ---- typed values ------------------------------------------------------
//
// Any value whose type implements `Data` (every type without functions in
// it) converts to JSON and back, in the shape `brim gen ts` declares:
//
//   struct Note { id: i64, text: string, tags: List[string] }
//
//   let text = json.encode(Note { id: 1, text: "milk", tags: [] })
//   // {"id":1,"text":"milk","tags":[]}
//   let note: Note = json.decode(text)?
//
// Structs are objects; `Option` is the value or `null`; an enum without
// payloads is its variant's name, others `{"kind": "A", "value": ...}`;
// tuples and sets are arrays; maps are objects with the keys as text.
// Decoding reports where it failed: `at $.tags[2]: expected a string,
// found a number`.

// A value as compact JSON text.
pub fn encode[T: Data](value: T) -> string {
    return stringify(__to_json(value))
}

// A value as a `Json`.
pub fn to_json[T: Data](value: T) -> Json {
    return __to_json(value)
}

// A value of type `T` from JSON text.
pub fn decode[T: Data](text: string) -> Result[T, string] {
    let value = parse(text)?
    return __from_json(value)
}

// A value of type `T` from a `Json`.
pub fn from_json[T: Data](value: Json) -> Result[T, string] {
    return __from_json(value)
}

// The rest of this section is called by the code the compiler generates for
// `to_json` and `from_json`.

fn data_error(path: string, expected: string, found: Json) -> string {
    let what = match found {
        Json.Null => "null"
        Json.Bool(_) => "a bool"
        Json.Number(_) => "a number"
        Json.Str(_) => "a string"
        Json.Array(_) => "an array"
        Json.Object(_) => "an object"
    }
    return f"at {path}: expected {expected}, found {what}"
}

fn data_i64(value: Json, path: string) -> Result[i64, string] {
    match value.as_int() {
        Some(n) => return Ok(n)
        None => return Err(data_error(path, "a whole number", value))
    }
}

fn data_i32(value: Json, path: string) -> Result[i32, string] {
    let n = data_i64(value, path)?
    if n < -2147483648 || n > 2147483647 {
        return Err(f"at {path}: {n} does not fit in i32")
    }
    return Ok(to_i32(n))
}

fn data_u8(value: Json, path: string) -> Result[u8, string] {
    let n = data_i64(value, path)?
    if n < 0 || n > 255 {
        return Err(f"at {path}: {n} does not fit in u8")
    }
    return Ok(to_u8(n))
}

fn data_u64(value: Json, path: string) -> Result[u64, string] {
    let n = data_i64(value, path)?
    if n < 0 {
        return Err(f"at {path}: {n} does not fit in u64")
    }
    return Ok(to_u64(n))
}

fn data_f64(value: Json, path: string) -> Result[f64, string] {
    match value.as_float() {
        Some(x) => return Ok(x)
        None => return Err(data_error(path, "a number", value))
    }
}

fn data_bool(value: Json, path: string) -> Result[bool, string] {
    match value.as_bool() {
        Some(b) => return Ok(b)
        None => return Err(data_error(path, "a bool", value))
    }
}

fn data_string(value: Json, path: string) -> Result[string, string] {
    match value.as_string() {
        Some(text) => return Ok(text)
        None => return Err(data_error(path, "a string", value))
    }
}

fn data_array(value: Json, path: string) -> Result[List[Json], string] {
    match value.as_array() {
        Some(items) => return Ok(items)
        None => return Err(data_error(path, "an array", value))
    }
}

// An array of exactly `n` values, for a tuple or a variant's payload.
fn data_tuple(value: Json, path: string, n: i64) -> Result[List[Json], string] {
    let items = data_array(value, path)?
    if items.len() != n {
        return Err(f"at {path}: expected {n} values, found {items.len()}")
    }
    return Ok(items)
}

fn data_object(value: Json, path: string) -> Result[Map[string, Json], string] {
    match value.as_object() {
        Some(members) => return Ok(members)
        None => return Err(data_error(path, "an object", value))
    }
}

// A member of an object; `null` when it is missing, so an `Option` field
// can be left out.
fn data_member(members: Map[string, Json], name: string) -> Json {
    match members.get(name) {
        Some(value) => return value
        None => return Json.Null
    }
}

// The variant name of an enum value: `"Red"` or `{"kind": "Red", ...}`.
fn data_kind(value: Json, path: string, type_name: string) -> Result[string, string] {
    match value {
        Json.Str(name) => return Ok(name)
        Json.Object(members) => {
            match data_member(members, "kind") {
                Json.Str(name) => return Ok(name)
                _ => return Err(f"at {path}: expected a {type_name} with a \"kind\"")
            }
        }
        _ => return Err(data_error(path, f"a {type_name}", value))
    }
}

// The payload of an enum value: its `"value"` member.
fn data_payload(value: Json) -> Json {
    match value {
        Json.Object(members) => return data_member(members, "value")
        _ => return Json.Null
    }
}

fn data_unknown_variant(path: string, kind: string, type_name: string) -> string {
    return f"at {path}: {type_name} has no variant \"{kind}\""
}

// A map key read back as JSON, for keys that are not strings: `"7"` is a
// number and `"true"` a bool.
fn data_key(key: string) -> Json {
    if key == "true" || key == "false" {
        return Json.Bool(key == "true")
    }
    match key.parse_int() {
        Some(_) => return Json.Number(key)
        None => return Json.Str(key)
    }
}

// ---- parsing -----------------------------------------------------------

// Parses JSON text. Errors say what is wrong and where, counting
// characters from 1: "expected ':' at character 9".
pub fn parse(text: string) -> Result[Json, string] {
    let mut p: Parser = Parser { chars: text.chars(), pos: 0, depth: 0 }
    let value: Json = p.value()?
    p.skip_space()
    if p.pos < p.chars.len() {
        return Err(p.error("unexpected text after the value"))
    }
    return Ok(value)
}

struct Parser {
    chars: List[string],
    pos: i64,
    depth: i64,
}

impl Parser {
    fn peek(self) -> string {
        if self.pos < self.chars.len() {
            return self.chars[self.pos]
        }
        return ""
    }

    fn error(self, message: string) -> string {
        if self.pos >= self.chars.len() {
            return message + " at the end of the text"
        }
        return message + " at character " + to_string(self.pos + 1)
    }

    fn skip_space(mut self) {
        while self.pos < self.chars.len() {
            let c: string = self.chars[self.pos]
            if c == " " || c == "\n" || c == "\r" || c == "\t" {
                self.pos += 1
            } else {
                break
            }
        }
    }

    fn value(mut self) -> Result[Json, string] {
        self.skip_space()
        let c: string = self.peek()
        if c == "{" {
            return self.object()
        }
        if c == "[" {
            return self.array()
        }
        if c == "\"" {
            return Ok(Json.Str(self.string()?))
        }
        if c == "t" {
            return self.word("true", Json.Bool(true))
        }
        if c == "f" {
            return self.word("false", Json.Bool(false))
        }
        if c == "n" {
            return self.word("null", Json.Null)
        }
        if c == "-" || is_digit(c) {
            return self.number()
        }
        if c.is_empty() {
            return Err(self.error("expected a value"))
        }
        return Err(self.error("unexpected character '" + c + "'"))
    }

    fn word(mut self, word: string, value: Json) -> Result[Json, string] {
        for expected in word.chars() {
            if self.peek() != expected {
                return Err(self.error("expected " + word))
            }
            self.pos += 1
        }
        return Ok(value)
    }

    fn enter(mut self) -> Result[i64, string] {
        self.depth += 1
        if self.depth > 128 {
            return Err(self.error("nested too deeply"))
        }
        self.pos += 1
        return Ok(self.depth)
    }

    fn array(mut self) -> Result[Json, string] {
        self.enter()?
        let mut items: List[Json] = []
        self.skip_space()
        if self.peek() == "]" {
            self.pos += 1
            self.depth -= 1
            return Ok(Json.Array(items))
        }
        while true {
            items.push(self.value()?)
            self.skip_space()
            let c: string = self.peek()
            self.pos += 1
            if c == "]" {
                break
            }
            if c != "," {
                self.pos -= 1
                return Err(self.error("expected ',' or ']'"))
            }
        }
        self.depth -= 1
        return Ok(Json.Array(items))
    }

    fn object(mut self) -> Result[Json, string] {
        self.enter()?
        let mut members: Map[string, Json] = [:]
        self.skip_space()
        if self.peek() == "}" {
            self.pos += 1
            self.depth -= 1
            return Ok(Json.Object(members))
        }
        while true {
            self.skip_space()
            if self.peek() != "\"" {
                return Err(self.error("expected a string key"))
            }
            let key: string = self.string()?
            self.skip_space()
            if self.peek() != ":" {
                return Err(self.error("expected ':'"))
            }
            self.pos += 1
            members[key] = self.value()?
            self.skip_space()
            let c: string = self.peek()
            self.pos += 1
            if c == "}" {
                break
            }
            if c != "," {
                self.pos -= 1
                return Err(self.error("expected ',' or '}'"))
            }
        }
        self.depth -= 1
        return Ok(Json.Object(members))
    }

    // A string literal, after which `pos` is past its closing quote.
    fn string(mut self) -> Result[string, string] {
        self.pos += 1
        let mut parts: List[string] = []
        while true {
            let c: string = self.peek()
            if c.is_empty() {
                return Err(self.error("unterminated string"))
            }
            self.pos += 1
            if c == "\"" {
                break
            }
            if c == "\\" {
                parts.push(self.escape()?)
            } else {
                if __char_code(c) < 32 {
                    self.pos -= 1
                    return Err(self.error("control character in a string"))
                }
                parts.push(c)
            }
        }
        return Ok(parts.join(""))
    }

    fn escape(mut self) -> Result[string, string] {
        let c: string = self.peek()
        self.pos += 1
        match c {
            "\"" => return Ok("\"")
            "\\" => return Ok("\\")
            "/" => return Ok("/")
            "b" => return Ok("\u{8}")
            "f" => return Ok("\u{c}")
            "n" => return Ok("\n")
            "r" => return Ok("\r")
            "t" => return Ok("\t")
            "u" => {
                let mut code: i64 = self.hex4()?
                // A surrogate pair: 😀.
                if code >= 55296 && code <= 56319 {
                    if self.peek() != "\\" {
                        return Err(self.error("unpaired surrogate"))
                    }
                    self.pos += 1
                    if self.peek() != "u" {
                        return Err(self.error("unpaired surrogate"))
                    }
                    self.pos += 1
                    let low: i64 = self.hex4()?
                    if low < 56320 || low > 57343 {
                        return Err(self.error("unpaired surrogate"))
                    }
                    code = 65536 + (code - 55296) * 1024 + (low - 56320)
                }
                let text: string = __char_from_code(code)
                if !__last_error().is_empty() {
                    return Err(self.error("unpaired surrogate"))
                }
                return Ok(text)
            }
            _ => {
                self.pos -= 1
                return Err(self.error("invalid escape"))
            }
        }
    }

    fn hex4(mut self) -> Result[i64, string] {
        let mut value: i64 = 0
        for i in 0..4 {
            match "0123456789abcdef".find(self.peek().to_lower()) {
                Some(digit) => {
                    if self.peek().is_empty() {
                        return Err(self.error("expected four hex digits"))
                    }
                    value = value * 16 + digit
                }
                None => return Err(self.error("expected four hex digits"))
            }
            self.pos += 1
        }
        return Ok(value)
    }

    fn number(mut self) -> Result[Json, string] {
        let start: i64 = self.pos
        if self.peek() == "-" {
            self.pos += 1
        }
        if self.peek() == "0" {
            self.pos += 1
        } else if is_digit(self.peek()) {
            self.digits()
        } else {
            return Err(self.error("expected a digit"))
        }
        if self.peek() == "." {
            self.pos += 1
            if !is_digit(self.peek()) {
                return Err(self.error("expected a digit"))
            }
            self.digits()
        }
        if self.peek() == "e" || self.peek() == "E" {
            self.pos += 1
            if self.peek() == "+" || self.peek() == "-" {
                self.pos += 1
            }
            if !is_digit(self.peek()) {
                return Err(self.error("expected a digit"))
            }
            self.digits()
        }
        let mut parts: List[string] = []
        for i in start..self.pos {
            parts.push(self.chars[i])
        }
        return Ok(Json.Number(parts.join("")))
    }

    fn digits(mut self) {
        while is_digit(self.peek()) {
            self.pos += 1
        }
    }
}

fn is_digit(c: string) -> bool {
    return !c.is_empty() && c >= "0" && c <= "9"
}
