// Log lines on standard error, with the time and a level:
//
//   use @std/log
//
//   log.info("listening on port 8080")
//   // 2026-10-15T08:30:01.123Z INFO listening on port 8080
use @std/time

pub fn info(message: string) {
    write("INFO", message)
}

pub fn warn(message: string) {
    write("WARN", message)
}

pub fn error(message: string) {
    write("ERROR", message)
}

fn write(level: string, message: string) {
    eprint(time.now().iso() + " " + level + " " + message)
}
